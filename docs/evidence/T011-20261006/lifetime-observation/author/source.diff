+    RememberVerify, RememberIdentity, RememberCoverage, RememberDuplicate,
+    Tracking, BeforeAccounting, BeforeIds, RetainedWait, Capacity, OpenMember,
+    VerifyMember, MemberIdentity, AfterAccounting, AfterIds, Snapshot, Coverage,
+}
+/// Predicate reasons are typed at their original rejection site, never text parsed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MemberFailureReason {
+    ApiError, Unknown, TrackingDisabled, HistoricalObjectSignaled, Capacity,
+    InvalidIdentity, IdentityChanged, NotOwned, SnapshotChanged, IdentitySet,
+    IncompleteHistory,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct MemberFailureSnapshot {
+    pub stage: MemberFailureStage,
+    pub reason: MemberFailureReason,
+    pub error_kind: io::ErrorKind,
+    pub raw_os_error: Option<i32>,
+    pub native_failure: Option<ProcessNativeFailure>,
+    pub total: [Option<u32>; 2],
+    pub active: [Option<u32>; 2],
+    pub id_counts: [Option<usize>; 2],
+    pub retained: usize,
+    pub staged: usize,
+}
+impl MemberFailureSnapshot {
+    fn new(stage: MemberFailureStage, retained: usize) -> Self {
+        Self { stage, reason: MemberFailureReason::Unknown,
+            error_kind: io::ErrorKind::Other, raw_os_error: None, native_failure: None,
+            total: [None; 2], active: [None; 2], id_counts: [None; 2], retained, staged: 0 }
+    }
+    fn failed(mut self, error: &io::Error) -> Self {
+        self.error_kind = error.kind();
+        self.raw_os_error = error.raw_os_error();
+        self.native_failure = process_native_failure(error);
+        self.reason = if self.raw_os_error.is_some() || self.native_failure.is_some() {
+            MemberFailureReason::ApiError
+        } else if let Some(reason) = error.get_ref().and_then(|e| e.downcast_ref::<MemberPredicateError>()) {
+            reason.reason
+        } else { self.reason };
+        self
+    }
+}
+#[derive(Debug)]
+struct MemberPredicateError { reason: MemberFailureReason, message: &'static str }
+impl std::fmt::Display for MemberPredicateError {
+    fn fmt(&self, output: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        output.write_str(self.message)
+    }
+}
+impl std::error::Error for MemberPredicateError {}
+fn member_rejection(kind: io::ErrorKind, reason: MemberFailureReason, message: &'static str) -> io::Error {
+    io::Error::new(kind, MemberPredicateError { reason, message })
